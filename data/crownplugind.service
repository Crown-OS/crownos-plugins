[Unit]
Description=CrownOS themes and plugins
Documentation=https://github.com/crown-os/crownos-plugins
Requires=crownplugind.socket
After=crownplugind.socket graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/crownplugind
Restart=on-failure
RestartSec=1
Nice=5

[Install]
WantedBy=graphical-session.target
